{
  "name": "pulso",
  "productName": "Pulso",
  "version": "0.1.0",
  "description": "Analiza tu PC: hardware, drivers, salud de los discos y potencial de overclock.",
  "main": "src/main/main.js",
  "author": "Franz",
  "private": true,
  "scripts": {
    "start": "electron .",
    "start:demo": "electron . --demo",
    "probe": "node scripts/probe.js",
    "test": "node --test",
    "fonts": "node scripts/copy-fonts.js",
    "icons": "python3 scripts/make-icons.py",
    "dist": "electron-builder --win nsis portable --x64 --publish never",
    "dist:installer": "electron-builder --win nsis --x64 --publish never",
    "dist:portable": "electron-builder --win portable --x64 --publish never"
  },
  "dependencies": {
    "systeminformation": "^5.33.16"
  },
  "devDependencies": {
    "@fontsource/hanken-grotesk": "^5.3.0",
    "@fontsource/saira-semi-condensed": "^5.3.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.franz.pulso",
    "productName": "Pulso",
    "copyright": "Franz",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!**/*.map"
    ],
    "win": {
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "asInvoker",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Pulso",
      "artifactName": "Pulso-Setup-${version}.exe",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "Pulso-Portable-${version}.exe"
    },
    "publish": null
  }
}
